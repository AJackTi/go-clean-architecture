APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://app:local-dev-password@postgres:5432/app?sslmode=disable
METRICS_ENABLED=false
OTEL_SERVICE_NAME=github.com/AJackTi/go-clean-architecture
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
AUTH_ENABLED=false
AUTH_BEARER_TOKEN_SHA256=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=20
RATE_LIMIT_MAX_CLIENTS=10000
RATE_LIMIT_IDLE_TTL=10m
# Development-only HMAC key for opaque cursor pagination. Replace with a
# random 32-byte secret in production and keep it identical across replicas.
CURSOR_SIGNING_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=local-dev-password
POSTGRES_PORT=5432
