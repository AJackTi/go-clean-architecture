APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://app:local-dev-password@postgres:5432/app?sslmode=disable
METRICS_ENABLED=false
OTEL_SERVICE_NAME=github.com/AJackTi/go-clean-architecture
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=local-dev-password
POSTGRES_PORT=5432
